fn calculate_wavelength(frequency f) -> f64 {
    const SPEED_OF_LIGHT = 3e8;
    return SPEED_OF_LIGHT / f;
}

fn main() {
    frequency f = 2400000000;  // 2.4 GHz in Hz
    f64 wavelength = calculate_wavelength(f);
    print("Frequency: ", f, " Hz");
    print("Wavelength: ", wavelength, " m");
}
